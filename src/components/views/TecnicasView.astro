---
import EcosistemaTecnicas from '../tecnicas/EcosistemaTecnicas.astro'
import { tecnicasMoleculares } from '../../lib/tecnicas'

const tecnicas = tecnicasMoleculares
---

<div class="tecnicas-view flex flex-col h-full overflow-hidden">

  <!-- Header -->
  <div
    class="shrink-0 px-6 py-4"
    style="border-bottom: 1px solid var(--border);"
  >
    <h2 class="font-mono text-lg font-bold" style="color: var(--accent-cyan);">🛠️ Ecosistema de Técnicas Moleculares</h2>
    <p class="text-xs mt-0.5" style="color: var(--text-muted);">
      Técnicas organizadas por nivel de implementación · click en una técnica para ver su animación
    </p>
  </div>

  <!-- Scrollable content — single column, panel appears inline above table -->
  <div class="flex-1 overflow-y-auto px-6 py-5">
    <EcosistemaTecnicas tecnicas={tecnicas} />
  </div>

</div>

<script>
  // ── Anim wrapper step controller ─────────────────────────────────────────
  function toInt(value: string | undefined | null, fallback: number): number {
    const n = Number.parseInt(String(value ?? ''), 10)
    return Number.isFinite(n) ? n : fallback
  }

  function restartAnimations(el: HTMLElement) {
    const clone = el.cloneNode(true) as HTMLElement
    el.parentNode!.replaceChild(clone, el)
    return clone
  }

  function setAnimStep(wrapper: HTMLElement, step: number) {
    const total = toInt(wrapper.dataset.totalSteps, 1)
    const nextStep = Math.min(Math.max(step, 1), total)
    wrapper.dataset.currentStep = String(nextStep)

    wrapper.className = wrapper.className
      .split(/\s+/)
      .filter(c => c && !/^step-\d+$/.test(c))
      .concat(`step-${nextStep}`)
      .join(' ')

    const prevBtn = wrapper.querySelector<HTMLButtonElement>('[data-action="anim-prev"]')
    const nextBtn = wrapper.querySelector<HTMLButtonElement>('[data-action="anim-next"]')
    const indicator = wrapper.querySelector('.step-indicator')
    if (indicator) indicator.textContent = `${nextStep} / ${total}`
    if (prevBtn) prevBtn.disabled = nextStep <= 1
    if (nextBtn) nextBtn.disabled = nextStep >= total

    wrapper.querySelectorAll<HTMLElement>('[data-phase]').forEach(el => {
      const phase = toInt(el.getAttribute('data-phase'), 1)
      const shouldShow = phase <= nextStep
      const wasHidden = el.style.display === 'none'
      if (shouldShow && wasHidden) {
        const fresh = restartAnimations(el)
        fresh.style.display = ''
      } else {
        el.style.display = shouldShow ? '' : 'none'
      }
    })
  }

  function initAnimWrapper(wrapper: HTMLElement) {
    if (wrapper.dataset.animBound) return
    wrapper.dataset.animBound = '1'
    wrapper.addEventListener('click', e => {
      const target = (e.target as Element).closest('[data-action]') as HTMLElement | null
      if (!target) return
      const action = target.getAttribute('data-action')
      if (action !== 'anim-prev' && action !== 'anim-next') return
      e.preventDefault()
      e.stopPropagation()
      setAnimStep(wrapper, toInt(wrapper.dataset.currentStep, 1) + (action === 'anim-next' ? 1 : -1))
    })
  }

  function resetAnimWrapper(wrapper: HTMLElement) {
    wrapper.querySelectorAll<HTMLElement>('[data-phase]').forEach(el => {
      const phase = toInt(el.getAttribute('data-phase'), 1)
      if (phase === 1) {
        const fresh = restartAnimations(el)
        fresh.style.display = ''
      } else {
        el.style.display = 'none'
      }
    })
    setAnimStep(wrapper, 1)
  }

  // ── Tecnica panel logic ──────────────────────────────────────────────────
  function selectTecnica(tecnicaId: string) {
    const inlinePanel = document.getElementById('tecnica-inline-panel')
    if (!inlinePanel) return

    inlinePanel.classList.remove('hidden')

    document.querySelectorAll<HTMLElement>('.tecnica-panel').forEach(panel => {
      const isActive = panel.id === `tecnica-panel-${tecnicaId}`
      panel.classList.toggle('hidden', !isActive)
      panel.classList.toggle('flex', isActive)

      if (isActive) {
        // Init + reset the anim wrapper inside this panel
        panel.querySelectorAll<HTMLElement>('.anim-wrapper[data-total-steps]').forEach(w => {
          initAnimWrapper(w)
          resetAnimWrapper(w)
        })
      }
    })

    document.querySelectorAll<HTMLElement>('[data-action="tecnica-select"]').forEach(btn => {
      const active = btn.dataset.tecnicaId === tecnicaId
      btn.style.borderColor = active ? 'rgba(0,229,255,0.4)' : ''
      btn.style.background  = active ? 'rgba(0,229,255,0.06)' : ''
    })

    inlinePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  }

  function closeTecnica() {
    const inlinePanel = document.getElementById('tecnica-inline-panel')
    if (!inlinePanel) return
    inlinePanel.classList.add('hidden')

    document.querySelectorAll<HTMLElement>('[data-action="tecnica-select"]').forEach(btn => {
      btn.style.borderColor = ''
      btn.style.background  = ''
    })
  }

  document.addEventListener('click', event => {
    const target = (event.target as Element).closest('[data-action]') as HTMLElement | null
    if (!target) return

    if (target.dataset.action === 'tecnica-select') {
      const id = target.dataset.tecnicaId
      if (id) selectTecnica(id)
    }

    if (target.dataset.action === 'tecnica-close') {
      closeTecnica()
    }
  })
</script>
