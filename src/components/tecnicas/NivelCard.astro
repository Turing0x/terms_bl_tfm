---
import type { Tecnica } from '../../lib/tecnicas'

export interface Props {
  nivel: 'campo' | 'regional' | 'referencia'
  tecnicas: Tecnica[]
}

const { nivel, tecnicas } = Astro.props

const nivelMeta = {
  campo:      { label: 'Nivel Campo',      sublabel: 'Sin laboratorio · POC',          color: '#39ff14', icon: '🏕️' },
  regional:   { label: 'Nivel Regional',   sublabel: 'Laboratorio básico equipado',    color: '#00e5ff', icon: '🔬' },
  referencia: { label: 'Nivel Referencia', sublabel: 'Lab. nacional / Centro I+D',     color: '#b388ff', icon: '🏛️' },
}[nivel]
---

<div
  class="nivel-card flex flex-col gap-3 p-4 rounded-2xl h-full"
  style={`background: var(--bg-card); border: 1px solid ${nivelMeta.color}30;`}
>
  <!-- Header -->
  <div
    class="px-3 py-2.5 rounded-xl -mx-1"
    style={`background: ${nivelMeta.color}10; border: 1px solid ${nivelMeta.color}30;`}
  >
    <div class="flex items-center gap-2">
      <span class="text-lg">{nivelMeta.icon}</span>
      <div>
        <div class="font-mono text-sm font-bold" style={`color: ${nivelMeta.color};`}>{nivelMeta.label}</div>
        <div class="text-xs mt-0.5" style="color: var(--text-muted);">{nivelMeta.sublabel}</div>
      </div>
    </div>
  </div>

  <!-- Techniques list -->
  <div class="flex flex-col gap-2">
    {tecnicas.map(tecnica => (
      <button
        class="tecnica-card-btn text-left p-3 rounded-xl transition-all group"
        data-action="tecnica-select"
        data-tecnica-id={tecnica.id}
        style="background: var(--bg-secondary); border: 1px solid var(--border);"
      >
        <div class="flex items-start justify-between gap-2 mb-1.5">
          <span class="font-mono text-sm font-bold" style="color: var(--text-primary);">
            {tecnica.nombre}
          </span>
          <span
            class="text-xs px-2 py-0.5 rounded-full shrink-0 font-mono"
            style={`background: ${nivelMeta.color}12; border: 1px solid ${nivelMeta.color}30; color: ${nivelMeta.color};`}
          >
            {nivel}
          </span>
        </div>
        <div class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs" style="color: var(--text-muted);">
          <span>LOD: <span style="color: var(--text-primary);">{tecnica.lod}</span></span>
          <span>Tiempo: <span style="color: var(--text-primary);">{tecnica.tiempo}</span></span>
          <span>Coste: <span style="color: var(--text-primary);">{tecnica.coste}</span></span>
        </div>
        <p class="text-xs mt-1.5 line-clamp-2" style="color: var(--text-muted);">{tecnica.escenario}</p>
      </button>
    ))}
  </div>
</div>

<style>
  .tecnica-card-btn:hover {
    border-color: rgba(0, 229, 255, 0.3) !important;
    background: rgba(0, 229, 255, 0.04) !important;
  }
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>
