<!-- ddPCR — 3 pasos controlados por botones -->
<div class="anim-wrapper step-1" data-total-steps="3" data-current-step="1">
  <svg viewBox="0 0 280 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Animación ddPCR">
    <text x="140" y="13" fill="#64748b" font-size="7.5" font-family="monospace" text-anchor="middle">~20.000 gotitas particionadas</text>

    <!-- Fase 1: gotitas apareciendo -->
    <g data-phase="1">
      {(() => {
        const positives = new Set([2, 5, 9, 13, 17, 21, 24, 28, 33, 37, 41, 45, 48, 53, 57])
        const items = []
        for (let row = 0; row < 6; row++) {
          for (let col = 0; col < 10; col++) {
            const idx = row * 10 + col
            const cx = 28 + col * 24
            const cy = 28 + row * 20
            const isPos = positives.has(idx)
            items.push(
              <circle
                cx={cx} cy={cy} r="8"
                fill={isPos ? 'rgba(57,255,20,0.25)' : 'rgba(30,58,95,0.6)'}
                stroke={isPos ? '#39ff14' : '#1e3a5f'}
                stroke-width={isPos ? '1.2' : '0.8'}
                class={isPos ? 'droplet-pos' : 'droplet-neg'}
              />
            )
          }
        }
        return items
      })()}
    </g>

    <!-- Fase 3: badge de conteo -->
    <g data-phase="3" style="display: none" class="count-badge">
      <rect x="76" y="138" width="128" height="17" rx="5" fill="rgba(57,255,20,0.1)" stroke="rgba(57,255,20,0.4)" stroke-width="0.8" />
      <text x="140" y="150" fill="#39ff14" font-size="7.5" font-family="monospace" text-anchor="middle" font-weight="bold">15 copias/µL — concentración absoluta</text>
    </g>

    <!-- Badge técnica -->
    <rect x="202" y="2" width="70" height="14" rx="4" fill="rgba(57,255,20,0.1)" stroke="rgba(57,255,20,0.4)" stroke-width="0.8" />
    <text x="237" y="12" fill="#39ff14" font-size="7.5" font-family="monospace" text-anchor="middle" font-weight="bold">ddPCR</text>
  </svg>

  <!-- Leyenda -->
  <div class="legend">
    <span class="leg"><span class="ldot" style="background:rgba(57,255,20,0.3);border:1px solid #39ff14"></span>gotita verde = diana detectada (positiva)</span>
    <span class="leg"><span class="ldot" style="background:rgba(30,58,95,0.6);border:1px solid #1e3a5f"></span>gotita oscura = sin diana (negativa)</span>
    <span class="leg"><span class="lnum">#</span>número = concentración absoluta sin curva estándar</span>
  </div>

  <div class="step-text step-text-1">
    <span class="snum">1/3</span>
    <p>La muestra se fracciona en <strong>~20.000 microgotas</strong>. Cada gota recibe estadísticamente 0 ó 1 molécula de ADN diana, según la distribución de Poisson.</p>
  </div>
  <div class="step-text step-text-2">
    <span class="snum">2/3</span>
    <p>PCR amplifica el ADN <strong>dentro de cada gota</strong> de forma independiente. Las gotas con diana emiten fluorescencia verde brillante. Las vacías permanecen oscuras.</p>
  </div>
  <div class="step-text step-text-3">
    <span class="snum">3/3</span>
    <p><strong>Conteo digital:</strong> positivas ÷ total = concentración absoluta. Sin curva estándar. Máxima precisión para ctDNA raro — detecta 1 molécula mutante entre 10.000 normales.</p>
  </div>

  <div class="step-controls">
    <button data-action="anim-prev" class="step-btn" disabled>← Anterior</button>
    <span class="step-indicator">1 / 3</span>
    <button data-action="anim-next" class="step-btn">Siguiente →</button>
  </div>
</div>

<style>
  .anim-wrapper { display: flex; flex-direction: column; gap: 5px; }
  svg { width: 100%; }

  .legend {
    display: flex; flex-wrap: wrap; gap: 4px 10px;
    padding: 4px 7px; background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07); border-radius: 5px;
    font-family: monospace; font-size: 0.6rem; color: var(--text-muted);
  }
  .leg { display: flex; align-items: center; gap: 4px; }
  .ldot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .lnum { display: inline-block; width: 14px; text-align: center; font-weight: bold; color: #39ff14; flex-shrink: 0; }

  .step-text { display: none; align-items: flex-start; gap: 6px; padding: 5px 7px; background: rgba(57,255,20,0.03); border: 1px solid rgba(57,255,20,0.12); border-radius: 5px; min-height: 3.5rem; }
  .step-1 .step-text-1, .step-2 .step-text-2, .step-3 .step-text-3 { display: flex; }
  .snum { font-family: monospace; font-size: 0.58rem; color: #39ff14; flex-shrink: 0; font-weight: bold; padding-top: 1px; }
  .step-text p { font-size: 0.62rem; line-height: 1.42; color: var(--text-primary); margin: 0; }
  .step-text strong { color: #39ff14; font-weight: 600; }

  .step-controls { display: flex; align-items: center; justify-content: space-between; padding-top: 5px; border-top: 1px solid var(--border); }
  .step-btn { font-family: monospace; font-size: 0.65rem; padding: 4px 10px; border-radius: 5px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-muted); cursor: pointer; transition: all 0.15s; }
  .step-btn:hover:not(:disabled) { color: #39ff14; border-color: rgba(57,255,20,0.3); background: rgba(57,255,20,0.06); }
  .step-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .step-indicator { font-family: monospace; font-size: 0.65rem; color: #39ff14; font-weight: bold; }

  .droplet-neg { animation: drop-appear 0.8s ease-out forwards; }
  .droplet-pos {
    animation: drop-appear 0.8s ease-out forwards, droplet-pulse 1.8s ease-in-out 0.8s infinite;
    filter: drop-shadow(0 0 3px #39ff14);
  }
  .count-badge { animation: fade-in 0.5s ease-out forwards; }

  @keyframes drop-appear {
    from { opacity: 0; transform: scale(0.3); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes droplet-pulse {
    0%, 100% { filter: drop-shadow(0 0 3px #39ff14); }
    50%       { filter: drop-shadow(0 0 7px #39ff14) drop-shadow(0 0 12px rgba(57,255,20,0.5)); }
  }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
</style>

<script is:inline>
  (function () {
    function toInt(value, fallback) {
      const n = Number.parseInt(String(value ?? ''), 10);
      return Number.isFinite(n) ? n : fallback;
    }

    function setStep(wrapper, step) {
      const total = toInt(wrapper.dataset.totalSteps, 1);
      const nextStep = Math.min(Math.max(step, 1), total);
      wrapper.dataset.currentStep = String(nextStep);

      wrapper.className = wrapper.className
        .split(/\s+/)
        .filter((c) => c && !/^step-\d+$/.test(c))
        .concat(`step-${nextStep}`)
        .join(' ');

      const prevBtn = wrapper.querySelector('[data-action="anim-prev"]');
      const nextBtn = wrapper.querySelector('[data-action="anim-next"]');
      const indicator = wrapper.querySelector('.step-indicator');
      if (indicator) indicator.textContent = `${nextStep} / ${total}`;
      if (prevBtn) prevBtn.toggleAttribute('disabled', nextStep <= 1);
      if (nextBtn) nextBtn.toggleAttribute('disabled', nextStep >= total);

      wrapper.querySelectorAll('[data-phase]').forEach((el) => {
        const phase = toInt(el.getAttribute('data-phase'), 1);
        el.style.display = phase <= nextStep ? '' : 'none';
      });
    }

    function init(wrapper) {
      setStep(wrapper, toInt(wrapper.dataset.currentStep, 1));
      wrapper.addEventListener('click', (e) => {
        const target = e.target instanceof Element ? e.target.closest('[data-action]') : null;
        if (!target) return;
        const action = target.getAttribute('data-action');
        if (action !== 'anim-prev' && action !== 'anim-next') return;
        e.preventDefault();
        setStep(wrapper, toInt(wrapper.dataset.currentStep, 1) + (action === 'anim-next' ? 1 : -1));
      });
    }

    document.querySelectorAll('.anim-wrapper[data-total-steps]').forEach((w) => init(w));
  })();
</script>
