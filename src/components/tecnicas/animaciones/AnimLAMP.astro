<!-- LAMP — 3 pasos controlados por botones -->
<div class="anim-wrapper step-1" data-total-steps="3" data-current-step="1">
  <svg viewBox="0 0 280 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Animación LAMP">

    <!-- Badges siempre visibles -->
    <rect x="8" y="4" width="52" height="16" rx="5" fill="rgba(255,179,0,0.12)" stroke="rgba(255,179,0,0.5)" stroke-width="0.8" />
    <text x="34" y="15" fill="#ffb300" font-size="8" font-family="monospace" text-anchor="middle" font-weight="bold">65°C cte.</text>
    <rect x="218" y="4" width="54" height="16" rx="5" fill="rgba(0,229,255,0.1)" stroke="rgba(0,229,255,0.4)" stroke-width="0.8" />
    <text x="245" y="15" fill="#00e5ff" font-size="8" font-family="monospace" text-anchor="middle" font-weight="bold">LAMP</text>

    <!-- Fase 1: dsDNA abierto + puntos separación -->
    <g data-phase="1">
      <line x1="40" y1="68" x2="240" y2="68" stroke="#00e5ff" stroke-width="2" stroke-linecap="round" class="dna-top" />
      <line x1="40" y1="78" x2="240" y2="78" stroke="#b388ff" stroke-width="2" stroke-linecap="round" class="dna-bot" />
      {[80, 110, 140, 170, 200].map(x => (
        <circle cx={x} cy={73} r="2" fill="#64748b" class="sep-dot" />
      ))}
    </g>

    <!-- Fase 2: primer bucle stem-loop -->
    <g data-phase="2" style="display: none">
      <path d="M 80,68 Q 60,40 80,25 Q 100,10 120,25 Q 140,40 120,68"
        stroke="#39ff14" stroke-width="2" fill="none" stroke-linecap="round" class="loop-1" />
    </g>

    <!-- Fase 3: bucles en cascada + label -->
    <g data-phase="3" style="display: none">
      <path d="M 160,68 Q 150,42 165,28 Q 180,14 195,28 Q 210,42 200,68"
        stroke="#ffb300" stroke-width="2" fill="none" stroke-linecap="round" class="loop-2" />
      <path d="M 110,78 Q 100,95 115,108 Q 130,118 145,108 Q 160,96 150,78"
        stroke="#b388ff" stroke-width="2" fill="none" stroke-linecap="round" class="loop-3" />
      <text x="140" y="148" fill="#39ff14" font-size="7.5" font-family="monospace" text-anchor="middle" class="cascade-label">→ amplificación exponencial isotérmica</text>
    </g>
  </svg>

  <!-- Leyenda -->
  <div class="legend">
    <span class="leg"><span class="lbar" style="background:#00e5ff"></span>cadena superior (ADN template)</span>
    <span class="leg"><span class="lbar" style="background:#b388ff"></span>cadena complementaria</span>
    <span class="leg"><span class="lbar" style="background:#39ff14"></span>bucle = estructura stem-loop autorreplicante</span>
    <span class="leg"><span class="ldot" style="background:#64748b"></span>puntos = separación de cadenas a 65°C</span>
  </div>

  <div class="step-text step-text-1">
    <span class="snum">1/3</span>
    <p>A <strong>65°C constante</strong> el ADN se desnaturaliza sin termociclador. Un baño de agua, resistencia eléctrica o incluso calor corporal es suficiente para mantener la temperatura.</p>
  </div>
  <div class="step-text step-text-2">
    <span class="snum">2/3</span>
    <p>Un primer especial (<strong>FIP/BIP</strong>) invade la cadena abierta y sintetiza el primer <strong>bucle stem-loop</strong>. La estructura en horquilla puede autorreplicarse sin más instrucciones externas.</p>
  </div>
  <div class="step-text step-text-3">
    <span class="snum">3/3</span>
    <p>Los bucles se auto-primerían en cascada, generando <strong>amplificación exponencial</strong>. Resultado visible (turbidez o cambio de color) en <strong>15–30 min</strong>. Ideal para diagnóstico de campo.</p>
  </div>

  <div class="step-controls">
    <button data-action="anim-prev" class="step-btn" disabled>← Anterior</button>
    <span class="step-indicator">1 / 3</span>
    <button data-action="anim-next" class="step-btn">Siguiente →</button>
  </div>
</div>

<style>
  .anim-wrapper { display: flex; flex-direction: column; gap: 5px; }
  svg { width: 100%; }

  .legend {
    display: flex; flex-wrap: wrap; gap: 4px 10px;
    padding: 4px 7px; background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07); border-radius: 5px;
    font-family: monospace; font-size: 0.6rem; color: var(--text-muted);
  }
  .leg { display: flex; align-items: center; gap: 4px; }
  .lbar { display: inline-block; width: 14px; height: 2px; border-radius: 1px; flex-shrink: 0; }
  .ldot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }

  .step-text { display: none; align-items: flex-start; gap: 6px; padding: 5px 7px; background: rgba(0,229,255,0.04); border: 1px solid rgba(0,229,255,0.12); border-radius: 5px; min-height: 3.5rem; }
  .step-1 .step-text-1, .step-2 .step-text-2, .step-3 .step-text-3 { display: flex; }
  .snum { font-family: monospace; font-size: 0.58rem; color: var(--accent-cyan); flex-shrink: 0; font-weight: bold; padding-top: 1px; }
  .step-text p { font-size: 0.62rem; line-height: 1.42; color: var(--text-primary); margin: 0; }
  .step-text strong { color: var(--accent-amber); font-weight: 600; }

  .step-controls { display: flex; align-items: center; justify-content: space-between; padding-top: 5px; border-top: 1px solid var(--border); }
  .step-btn { font-family: monospace; font-size: 0.65rem; padding: 4px 10px; border-radius: 5px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-muted); cursor: pointer; transition: all 0.15s; }
  .step-btn:hover:not(:disabled) { color: var(--accent-cyan); border-color: rgba(0,229,255,0.3); background: rgba(0,229,255,0.06); }
  .step-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .step-indicator { font-family: monospace; font-size: 0.65rem; color: var(--accent-cyan); font-weight: bold; }

  .dna-top { stroke-dasharray: 200; stroke-dashoffset: 200; animation: draw-line 1s ease-out forwards; }
  .dna-bot { stroke-dasharray: 200; stroke-dashoffset: 200; animation: draw-line 1s ease-out 0.15s forwards; }
  .sep-dot { opacity: 0; animation: fade-in 0.4s ease-out 0.8s forwards; }
  .loop-1 { stroke-dasharray: 180; stroke-dashoffset: 180; animation: draw-line 1.2s ease-out forwards; }
  .loop-2 { stroke-dasharray: 160; stroke-dashoffset: 160; animation: draw-line 1.2s ease-out forwards; }
  .loop-3 { stroke-dasharray: 160; stroke-dashoffset: 160; animation: draw-line 1.2s ease-out 0.5s forwards; }
  .cascade-label { opacity: 0; animation: fade-in 0.5s ease-out 1.2s forwards; }

  @keyframes draw-line { to { stroke-dashoffset: 0; } }
  @keyframes fade-in   { to { opacity: 1; } }
</style>

<script is:inline>
  (function () {
    function toInt(value, fallback) {
      const n = Number.parseInt(String(value ?? ''), 10);
      return Number.isFinite(n) ? n : fallback;
    }

    function setStep(wrapper, step) {
      const total = toInt(wrapper.dataset.totalSteps, 1);
      const nextStep = Math.min(Math.max(step, 1), total);
      wrapper.dataset.currentStep = String(nextStep);

      wrapper.className = wrapper.className
        .split(/\s+/)
        .filter((c) => c && !/^step-\d+$/.test(c))
        .concat(`step-${nextStep}`)
        .join(' ');

      const prevBtn = wrapper.querySelector('[data-action="anim-prev"]');
      const nextBtn = wrapper.querySelector('[data-action="anim-next"]');
      const indicator = wrapper.querySelector('.step-indicator');
      if (indicator) indicator.textContent = `${nextStep} / ${total}`;
      if (prevBtn) prevBtn.toggleAttribute('disabled', nextStep <= 1);
      if (nextBtn) nextBtn.toggleAttribute('disabled', nextStep >= total);

      wrapper.querySelectorAll('[data-phase]').forEach((el) => {
        const phase = toInt(el.getAttribute('data-phase'), 1);
        el.style.display = phase <= nextStep ? '' : 'none';
      });
    }

    function init(wrapper) {
      setStep(wrapper, toInt(wrapper.dataset.currentStep, 1));
      wrapper.addEventListener('click', (e) => {
        const target = e.target instanceof Element ? e.target.closest('[data-action]') : null;
        if (!target) return;
        const action = target.getAttribute('data-action');
        if (action !== 'anim-prev' && action !== 'anim-next') return;
        e.preventDefault();
        setStep(wrapper, toInt(wrapper.dataset.currentStep, 1) + (action === 'anim-next' ? 1 : -1));
      });
    }

    document.querySelectorAll('.anim-wrapper[data-total-steps]').forEach((w) => init(w));
  })();
</script>
